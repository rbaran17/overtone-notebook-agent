# Copy to backend/.env (the `overtone` CLI and server load it from the directory they run in).

# Claude: required for real answers. Runs through Microsoft Agent Framework's Anthropic client.
ANTHROPIC_API_KEY=

# OpenAI: optional. One key enables two things:
#   - rendered podcast audio (text-to-speech), and
#   - live voice with GPT-Live (talk to your notebook, join an episode).
OPENAI_API_KEY=

# ElevenLabs: optional alternative for rendered podcast audio.
ELEVENLABS_API_KEY=

# With no speech key at all, audio overviews still get a full script and the web UI
# reads it aloud with the browser's own voices.

# --- Try it without any keys ---
# OVERTONE_MOCK=1                       # deterministic stand-in model, no network calls

# --- Optional tuning ---
# OVERTONE_MODEL=claude-opus-5-5
# OVERTONE_DATA_DIR=.overtone           # where notebooks are stored
# OVERTONE_API_KEY=                     # require "Authorization: Bearer <key>" on the REST API
# OVERTONE_TTS_PROVIDER=auto            # auto | openai | elevenlabs | none
# OVERTONE_TTS_MODEL=
# OVERTONE_TTS_VOICES=coral,ash         # voice for host 1, host 2
# OVERTONE_LIVE=0                       # turn live voice off even when OPENAI_API_KEY is set
# OVERTONE_LIVE_MODEL=gpt-live-1
# OVERTONE_LIVE_VOICE=marin
# OVERTONE_ALLOW_PRIVATE_URLS=1         # allow URL sources on localhost / private networks
# OVERTONE_FALLBACKS=0                  # disable server-side model fallback on refusals

# --- Web UI (set in the shell that runs `npm run dev`, or in .env.local at the repo root) ---
# OVERTONE_API_URL=http://127.0.0.1:8787   # where the Next.js app forwards /api/*
